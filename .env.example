# --- WhatsApp Cloud API (Meta test number) ---
WA_TOKEN=EAAG...                       # permanent system-user token
WA_PHONE_NUMBER_ID=1468032779716603
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=                         # verifies X-Hub-Signature-256 (required unless DEMO_MODE and empty)
WA_VERIFY_TOKEN=change-me-verify
WA_API_VERSION=v23.0
WA_TEST_NUMBER=15551234567             # display number digits, used in the wa.me consent QR link

# --- AI ---
AI_MODE=auto                           # auto = Gemini if GEMINI_API_KEY is set, else offline rules; fixture = tests/sim
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# --- Runtime ---
DATABASE_URL=sqlite+aiosqlite:///./chanakya.db   # Railway: postgresql://... (auto → postgresql+asyncpg://)
PUBLIC_BASE_URL=https://xyz.ngrok-free.app
ADMIN_TOKEN=change-me
TZ_NAME=Asia/Kolkata
STORE_ID=RD-JUHU
LOG_LEVEL=INFO
RENDER_CARDS=true
SCHEDULER_ENABLED=true

# --- Test phones (verified recipients of the Meta test number; ≤ 5) ---
ASSOCIATE_PHONE=91...
ASSOCIATE_NAME=Ravi
CUSTOMER_PHONE=91...
MANAGER_PHONE=91...
MANAGER_NAME=Meena
EXPERT_PHONE=91...
EXPERT_NAME=Sunil
VISITOR_PHONE=

# --- Demo ---
DEMO_MODE=true                         # enables /role, /clock, reset
DEMO_ROLE_SWITCH_ALLOWED=91...,91...   # empty = any staff phone may switch
HARMONISE_TRYON=true                   # Gemini blends the to-scale composite (geometry verified)
